{
  "agent": {
    "allow_parallel_tool_calls": true,
    "api_base": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "api_key": "sk-default",
    "api_keys": [
      "sk-key-a",
      "sk-key-b"
    ],
    "enable_thinking": true,
    "max_empty_tool_call_retries": 8,
    "max_steps": 24,
    "max_tokens": 32768,
    "model": "qwen3-coder",
    "rate_limit": {
      "backoff_initial_seconds": 1.0,
      "backoff_max_seconds": 30.0,
      "max_retries": 6,
      "reserve_output_tokens": 16384,
      "rpm_per_key": 600,
      "safety_factor": 0.85,
      "state_dir": "/tmp/ratelimit/run-x",
      "tpm_per_key": 1000000
    },
    "temperature": 0.0,
    "tool_protocol": "native"
  },
  "dataset": {
    "root_path": "/tmp/dataset"
  },
  "run": {
    "blocklist": [],
    "max_workers": 4,
    "output_dir": "/tmp/runs",
    "run_id": "pinned-run-id",
    "task_timeout_seconds": 600
  }
}
