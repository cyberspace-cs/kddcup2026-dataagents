            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "rows": {
          "description": "Answer rows; each row's length must match the columns array.",
          "items": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array"
          },
          "type": "array"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "type": "object"
    }
  },
  "type": "function"
}
